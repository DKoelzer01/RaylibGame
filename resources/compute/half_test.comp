#version 430
// --test-half (#968): each float through the half rounding fluid_step.comp stores its face flows with (packHalfRN,
// half_rn.glsl). The bench compares the results bit for bit with the CPU kernel's half rounding (FluidKernel::HalfRound,
// nearest even). packHalf2x16 alone rounds as the driver likes (NVIDIA: toward zero, #2116), so the step rounds first.
// The packed bits go back as stored: NVIDIA folds unpackHalf2x16(packHalf2x16(f)) to f, so a round trip in the shader
// measured nothing; the bench decodes them.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Data { uint v[]; };
uniform uint count;
#include "half_rn.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < count) v[i] = packHalfRN(vec2(uintBitsToFloat(v[i]), 0.0)) & 0xFFFFu;
}
