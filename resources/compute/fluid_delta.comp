#version 430
// Changes made on the CPU (buckets, pumps, springs, levelling: fluid.cpp GPU mode) applied to the GPU state.
// Each entry: global cell, signed fill change, kind (+8: set the kind when the cell was empty).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Cells { uint cells[]; };
struct Delta { uint cell; int delta; uint kind; uint pad; };
layout(std430, binding = 1) readonly buffer Deltas { Delta deltas[]; };
layout(std430, binding = 2) buffer Flags { uint flagsOut[]; };
uniform uint count;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    Delta d = deltas[i];
    uint c = cells[d.cell];
    int f = int(c & 255u);
    int nf = clamp(f + d.delta, 0, 255);
    uint fl = (c >> 8) & 255u;
    if (f == 0 && nf > 0) fl = (fl & 31u) | ((d.kind & 7u) << 5);
    cells[d.cell] = uint(nf) | (fl << 8) | (c & 0xFF0000u);
    atomicOr(flagsOut[d.cell / 4096u], 1u);
}
