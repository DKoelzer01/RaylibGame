#version 430
// --test-terrain-gpu (Plan 6 step 3): elevationBase at each point (direction xyz, footprint w).
layout(local_size_x = 64) in;
#include "terrain.glsl"
layout(std430, binding = 0) readonly buffer In { vec4 pts[]; };
layout(std430, binding = 1) writeonly buffer Out { float heights[]; };
uniform uint count;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    vec4 p = pts[i];
    heights[i] = elevationBase(p.xyz, p.w);
}
