#version 430
// Plan 6 step 2 (#145): culls one body's listed terrain chunks for one view and writes the indirect draw
// commands and per-draw records the terrain arena draws (terrainarena.cpp). One thread per listed chunk.
// Placement is done in double precision (chunks lie up to ~60 km from the body centre; the result is
// relative to the floating render origin and small), as ChunkPlacer does on the CPU.
// Culled chunks keep their command with instanceCount 0, so the list order (nearest first) is kept.
layout(local_size_x = 64) in;

struct Chunk { vec4 originSize; vec4 clip; uvec4 draw; uvec4 palette; }; // body-local origin + size; chunk-local clip; iCount, iFirst, vFirst; 16 material ids (#480)
layout(std430, binding = 0) readonly buffer Table { Chunk chunks[]; };
layout(std430, binding = 1) readonly buffer List { uint slots[]; };
struct Cmd { uint count; uint instances; uint firstIndex; int baseVertex; uint baseInstance; };
layout(std430, binding = 2) writeonly buffer Cmds { Cmd cmds[]; };
layout(std430, binding = 3) writeonly buffer Recs { uvec4 recs[]; };  // 6 per draw: model rows 0-2, texturing origin, clip (float bits); palette

uniform uint count;        // listed chunks
uniform uint base;         // this flush's first entry in the command / record ring
uniform dmat3 rot;         // body rotation
uniform double scale;
uniform dvec3 offset;      // body position - render origin
uniform double texPeriod;  // texture repeat (m): the texturing origin is the chunk origin wrapped to it
uniform int useFrustum;
uniform vec4 planes[6];    // render space
uniform int useColumn;     // shadow passes: the light box's column, body-local
uniform vec3 colPoint;
uniform vec3 colDir;
uniform float colRadius;
uniform float overlap;     // (CHUNK_SIZE + 1) / CHUNK_SIZE: the bounds include the overlap cell
// Hi-Z occlusion (#134, main pass): last frame's min-depth pyramid (reverse-Z: smaller = farther), the view-projection and
// the body placement it was drawn with. A chunk is skipped when its box, placed where it stood last frame, lies wholly
// on last frame's screen and its nearest point is farther than the farthest depth over its rectangle.
uniform int hizOn;
uniform sampler2D hizTex;
uniform vec2 hizSize;
uniform int hizLevels;
uniform vec3 hizCam;     // (#910) body-local camera
uniform float hizNear;   // (#910) nodes this close to it are never Hi-Z culled
uniform mat4 prevViewProj;
uniform dmat3 prevRot;
uniform double prevScale;
uniform dvec3 prevOffset;

bool hizOccluded(vec3 o, float side) {
    mat3 pm = mat3(prevRot * prevScale);
    vec3 pt = vec3(prevOffset + prevRot * dvec3(o) * prevScale);
    vec2 lo = vec2(1e9), hi = vec2(-1e9);
    float nearest = 0.0;
    for (int k = 0; k < 8; ++k) {
        vec3 corner = vec3(float(k & 1), float((k >> 1) & 1), float((k >> 2) & 1)) * side;
        vec4 c = prevViewProj * vec4(pm * corner + pt, 1.0);
        if (c.w <= 1e-3) return false;                 // reaches behind last frame's camera
        vec3 ndc = c.xyz / c.w;
        lo = min(lo, ndc.xy); hi = max(hi, ndc.xy);
        nearest = max(nearest, ndc.z);                 // reverse-Z: larger = nearer
    }
    // The part on last frame's screen (the rest is outside the view: the frustum test speaks for it; a sliver turned into
    // view since then is the one-frame latency, checked by the turning capture compare).
    // (#910) A box reaching past the edge of last frame's screen is kept: its part on that screen may have been hidden while
    // the part turned into view since is not (turning showed ground holes: grass standing over nothing for a frame).
    if (lo.x < -1.0 || lo.y < -1.0 || hi.x > 1.0 || hi.y > 1.0) return false;
    if (lo.x >= hi.x || lo.y >= hi.y) return false;
    vec2 p0 = (lo * 0.5 + 0.5) * hizSize, p1 = (hi * 0.5 + 0.5) * hizSize; // the rectangle in level-0 pixels
    vec2 px = p1 - p0;
    // A level where the rectangle spans at most 2 texels (so at most 3 x 3 cover it): coarser levels' texels reach far past
    // the box (often into the sky over a ridge, depth 0), and nothing was ever culled.
    int level = int(clamp(ceil(log2(max(max(px.x, px.y) * 0.5, 1.0))), 0.0, float(hizLevels - 1)));
    ivec2 size = textureSize(hizTex, level);
    // (#1532) Texel x of level L holds level-0 pixels [x * 2^L, (x + 1) * 2^L); a row's last texel also takes the odd
    // remainder (the pyramid halves sizes rounding down). Scaling uv by the level's size instead drifted up to a texel toward
    // the origin on sizes that aren't powers of two (1440 = 22 x 64 + 32), so the texel under the box's far edge could be
    // missed and the box culled behind nearer ground beside it.
    float cell = exp2(float(level));
    ivec2 t0 = clamp(ivec2(floor(p0 / cell)), ivec2(0), size - 1), t1 = clamp(ivec2(floor(p1 / cell)), ivec2(0), size - 1);
    t1 = min(t1, t0 + 3);
    float far0 = 1e30;
    for (int y = t0.y; y <= t1.y; ++y)
        for (int x = t0.x; x <= t1.x; ++x) far0 = min(far0, texelFetch(hizTex, ivec2(x, y), level).r);
    return nearest < far0 * 0.9999;                    // all of it behind what was drawn there (a hair of margin)
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    Chunk c = chunks[slots[base + i]];
    vec3 o = c.originSize.xyz;
    float h = c.originSize.w * 0.5;
    bool vis = true;
    if (useColumn == 1) {
        vec3 v = o + vec3(h) - colPoint;
        float along = dot(v, colDir), reach = colRadius + h * 1.75;
        if (dot(v, v) - along * along > reach * reach) vis = false;
    }
    dmat3 rs = rot * scale;
    vec3 t = vec3(offset + rot * dvec3(o) * scale);
    mat3 m = mat3(rs);
    if (vis && useFrustum == 1) {
        float hh = h * overlap;
        vec3 centre = m * vec3(hh) + t;
        float r = hh * 1.7320508 * float(scale);
        for (int k = 0; k < 6; ++k)
            if (dot(planes[k].xyz, centre) + planes[k].w < -r) { vis = false; break; }
    }
    if (vis && hizOn == 1 && distance(o + vec3(h), hizCam) - h * 1.7320508 > hizNear && hizOccluded(o, 2.0 * h * overlap)) vis = false; // #134; #910: not near the camera (walking parallax: last frame's depth was seen from another eye)
    uint e = base + i;
    cmds[e] = Cmd(c.draw.x, vis ? 1u : 0u, c.draw.y, int(c.draw.z), e);
    recs[e * 6u + 0u] = floatBitsToUint(vec4(m[0].x, m[1].x, m[2].x, t.x));
    recs[e * 6u + 1u] = floatBitsToUint(vec4(m[0].y, m[1].y, m[2].y, t.y));
    recs[e * 6u + 2u] = floatBitsToUint(vec4(m[0].z, m[1].z, m[2].z, t.z));
    dvec3 od = dvec3(o);
    vec3 tex = vec3(od - floor(od / texPeriod) * texPeriod);
    recs[e * 6u + 3u] = floatBitsToUint(vec4(tex, 0.0));
    recs[e * 6u + 4u] = floatBitsToUint(c.clip); // w: the LOD cross-fade (#243)
    recs[e * 6u + 5u] = c.palette;
}
