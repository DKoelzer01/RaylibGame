# Writes the build's version (git branch + short commit) into a generated source file (#501).
# Run at every build by the game_version target: cmake -DSRC=<repo> -DOUT=<file.cpp> -P game_version.cmake
# The file is rewritten only when the text changes, so an unchanged commit recompiles nothing.
find_package(Git QUIET)
set(branch "unknown")
set(commit "unknown")
set(dirty "")
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r)
    if(NOT r EQUAL 0 OR commit STREQUAL "")
        set(commit "unknown")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --abbrev-ref HEAD WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(branch STREQUAL "HEAD" OR branch STREQUAL "")
        # Detached (the playtest checkout): name the remote branch whose tip this is, else the nearest one containing it.
        execute_process(COMMAND "${GIT_EXECUTABLE}" branch -r --points-at HEAD WORKING_DIRECTORY "${SRC}"
                        OUTPUT_VARIABLE tips OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        string(REGEX REPLACE "[ \t]+" "" tips "${tips}") # "  origin/x" lines -> "origin/x"
        string(REPLACE "\n" ";" tips "${tips}")
        list(FILTER tips EXCLUDE REGEX "HEAD") # "origin/HEAD->origin/main"
        if(tips)
            list(GET tips 0 branch)
        else()
            execute_process(COMMAND "${GIT_EXECUTABLE}" name-rev --name-only --no-undefined --refs=refs/remotes/origin/* HEAD
                            WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r)
            if(NOT r EQUAL 0 OR branch STREQUAL "")
                set(branch "detached")
            else()
                string(REGEX REPLACE "[~^].*$" "" branch "${branch}")
                set(branch "${branch} (behind)")
            endif()
        endif()
        string(REGEX REPLACE "^(remotes/)?origin/" "" branch "${branch}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT changes STREQUAL "")
        set(dirty "+local changes")
    endif()
endif()
set(version "${branch} ${commit}")
if(dirty)
    set(version "${version} ${dirty}")
endif()
set(text "// Generated by cmake/game_version.cmake at build time (#501). Do not edit.\nconst char* kGameVersion = \"${version}\";\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
    message(STATUS "game version: ${version}")
endif()
